# ==============================================================================
# QMOOSA STANDARDIZED DAPP ENVIRONMENT BASELINE
# Multi-Provider RPC Fallbacks, Chain Invariants & Deployment Staging
# ==============================================================================

# Network & RPC Configuration
# Multi-provider JSON-RPC fallback list (comma-separated, ordered by preference)
RPC_FALLBACK_URLS="https://sepolia.gateway.tenderly.co,https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.org"
QUICKNODE_RPC_URL="https://example-sepolia.quiknode.pro/0000000000000000000000000000000000000000/"

# Target Chain Verification (Sepolia: 11155111, Arbitrum Sepolia: 421614, Base Sepolia: 84532)
EXPECTED_CHAIN_ID=11155111
EXPLORER_BASE_URL="https://sepolia.etherscan.io"

# Retry & Fault Tolerance Parameters
RPC_RETRY_MAX_ATTEMPTS=5
RPC_RETRY_INITIAL_DELAY_MS=500
RPC_RETRY_BACKOFF_FACTOR=2
RPC_RETRY_MAX_JITTER_MS=250
RPC_REQUEST_TIMEOUT_MS=10000

# Contract Addresses (Staged / Production Gated)
CORE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
TOKEN_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Telemetry & PQC Verification
PQC_ALGORITHM="ML-DSA-65"
PQC_SECURITY_LEVEL=3
ENABLE_STATE_CACHE=true
STATE_CACHE_TTL_MS=15000
