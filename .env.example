# ========================================================
# Global Production & Testnet Environment Configuration
# COPY THIS FILE TO .env - NEVER COMMIT REAL PRIVATE KEYS!
# ========================================================

# --- Environment Tier ---
ENVIRONMENT_TIER=testnet       # Options: testnet, staging, mainnet-production
DEBUG=false
LOG_LEVEL=info

# --- Blockchain RPC Endpoints (Solana / EVM / Algorand) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet          # devnet | testnet | mainnet-beta
EVM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
EVM_CHAIN_ID=11155111          # Sepolia: 11155111 | Ethereum Mainnet: 1
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud

# --- Post-Quantum & Classical Cryptography ---
PQC_ALGORITHM=ML-KEM-768      # NIST FIPS 203 Kyber
PQC_SIGNATURE=ML-DSA-65       # NIST FIPS 204 Dilithium
ENABLE_HYBRID_CRYPTO=true

# --- Quantum Simulator & Hardware Backend ---
QUANTUM_BACKEND=aer_simulator  # aer_simulator | ibm_brisbane | aws_braket
IBM_QUANTUM_TOKEN=your_ibm_quantum_api_key_here

# --- Artificial Intelligence & LLM Endpoints ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_ID=gemini-2.5-pro

# --- Safe Mock Keys for Local CI Testing (NEVER USE REAL ASSETS) ---
DEV_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
